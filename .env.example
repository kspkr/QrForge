# Copy to .env and adjust. Every value is optional.

# Public URL of your QRForge server (used in dynamic QR links).
QRFORGE_BASE_URL=http://localhost
# Host port for the web UI / API.
QRFORGE_PORT=80
# Change this before exposing the server.
POSTGRES_PASSWORD=qrforge

# open | closed (the first account can always register and becomes admin)
QRFORGE_REGISTRATION=open
# Create an admin on first start instead of registering in the browser.
QRFORGE_ADMIN_EMAIL=
QRFORGE_ADMIN_PASSWORD=

# Behind a reverse proxy: CIDRs whose X-Forwarded-For you trust.
QRFORGE_TRUSTED_PROXIES=
# Header carrying a 2-letter country code set by your proxy/CDN (e.g. CF-IPCountry).
QRFORGE_COUNTRY_HEADER=

# Optional SMTP for password-reset emails. Without it, reset links are written to the server log.
QRFORGE_SMTP_HOST=
QRFORGE_SMTP_PORT=587
QRFORGE_SMTP_USERNAME=
QRFORGE_SMTP_PASSWORD=
QRFORGE_SMTP_FROM=

# Used by docker/docker-compose.caddy.yml
QRFORGE_DOMAIN=
ACME_EMAIL=
